---
import Base from '../layouts/Base.astro';
import Calendar from '../components/Calendar';
import MonthStats from '../components/MonthStats.astro';
import { allSittings, allMlas } from '../lib/sittings';

const today = new Date();
const todayIso = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;

// Pick the month of the most recent sitting to open the calendar on; fall back to today.
const latestSitting = [...allSittings].sort((a, b) => b.date.localeCompare(a.date))[0];
const openMonth = latestSitting ? latestSitting.date.slice(0, 7) : todayIso.slice(0, 7);
const [openYear, openMonthNum] = openMonth.split('-').map(Number);
const MONTH_NAMES = ['January','February','March','April','May','June','July','August','September','October','November','December'];
const monthLabel = `${MONTH_NAMES[openMonthNum - 1]} ${openYear}`;

const monthSittings = allSittings.filter(s => s.date.startsWith(openMonth));
---
<Base title="TN Assembly Watch" current="calendar">
  <section class="intro">
    <div class="intro-copy">
      <div class="intro-eyebrow">A public dashboard for civic accountability</div>
      <h1 class="intro-title">Every sitting of the Tamil Nadu Legislative Assembly, unpacked.</h1>
      <p class="intro-sub">
        See how time was spent, who held the floor, what was actually debated —
        and jump to the exact minute of the video for any moment.
      </p>
    </div>
    <div class="intro-marks">
      <div class="mark"><div class="mark-value">{allSittings.length}</div><div class="mark-label">sittings tracked</div></div>
      <div class="mark"><div class="mark-value">{allMlas.length}</div><div class="mark-label">MLAs in the roster</div></div>
      <div class="mark"><div class="mark-value">17<span class="mark-th">th</span></div><div class="mark-label">Tamil Nadu Assembly</div></div>
    </div>
  </section>

  <section class="cal-section">
    <Calendar client:load sittings={allSittings} todayIso={todayIso} initialMonth={openMonth} />
  </section>

  <section class="stats-section">
    <MonthStats sittings={monthSittings} mlas={allMlas} monthLabel={monthLabel} />
  </section>
</Base>

<style>
  .intro { display: grid; grid-template-columns: 2fr 1fr; gap: 24px; margin-bottom: 28px; align-items: end; }
  @media (max-width: 900px) { .intro { grid-template-columns: 1fr; } }
  .intro-eyebrow {
    font-size: 11px; text-transform: uppercase; letter-spacing: 0.14em;
    color: #e11d48; font-weight: 600;
  }
  .intro-title {
    margin: 8px 0 12px; font-size: 34px; font-weight: 700;
    letter-spacing: -0.03em; line-height: 1.1; max-width: 720px;
  }
  .intro-sub { margin: 0; color: rgb(71 85 105); max-width: 620px; font-size: 15px; line-height: 1.5; }
  :root[data-theme="dark"] .intro-sub,
  :root:not([data-theme="light"]) .intro-sub { color: rgb(148 163 184); }

  .intro-marks { display: flex; gap: 12px; }
  .mark {
    flex: 1; padding: 12px 14px;
    background: rgb(248 250 252); border-radius: 12px; border: 1px solid rgb(226 232 240);
  }
  :root[data-theme="dark"] .mark,
  :root:not([data-theme="light"]) .mark {
    background: rgb(15 23 42); border-color: rgb(30 41 59);
  }
  .mark-value {
    font-size: 26px; font-weight: 700; letter-spacing: -0.02em; line-height: 1;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
  }
  .mark-th { font-size: 12px; opacity: 0.5; margin-left: 1px; }
  .mark-label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: rgb(100 116 139); margin-top: 6px; }

  .cal-section, .stats-section { margin-bottom: 28px; }
</style>
