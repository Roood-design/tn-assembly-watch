---
import Base from '../../layouts/Base.astro';
import TimelineRibbon from '../../components/TimelineRibbon';
import SpeakingTimeDonut from '../../components/SpeakingTimeDonut';
import VideoPlayer from '../../components/VideoPlayer';
import TranscriptViewer from '../../components/TranscriptViewer';
import type { Sitting, Mla } from '../../types';

// Statically pre-render one page per JSON file in data/sittings.
export async function getStaticPaths() {
  const sittingModules = import.meta.glob('../../../data/sittings/*.json', { eager: true });
  const mlas = (await import('../../../data/mlas.json')).default as Mla[];
  return Object.values(sittingModules).map((mod: any) => {
    const sitting = (mod.default ?? mod) as Sitting;
    return { params: { id: sitting.sitting_id }, props: { sitting, mlas } };
  });
}

const { sitting, mlas } = Astro.props as { sitting: Sitting; mlas: Mla[] };

const dateFmt = new Intl.DateTimeFormat('en-IN', {
  weekday: 'long', year: 'numeric', month: 'long', day: 'numeric',
}).format(new Date(sitting.date));

const totalHours = Math.floor(sitting.aggregates.total_active_seconds / 3600);
const totalMins = Math.round((sitting.aggregates.total_active_seconds % 3600) / 60);

const walkouts = sitting.events.filter(e => e.type === 'walkout');
const adjournments = sitting.events.filter(e => e.type === 'adjournment');

// Compute high-level insights for the "Key Insights" panel.
const totalSpeaking = Object.values(sitting.aggregates.speaking_time_by_party).reduce((a, b) => a + (b ?? 0), 0);
const rulingSecs = sitting.aggregates.speaking_time_by_speaker
  .filter(s => mlas.find(m => m.mla_id === s.mla_id)?.alliance === 'ruling')
  .reduce((a, s) => a + s.seconds, 0);
const rulingPct = totalSpeaking > 0 ? Math.round((rulingSecs / totalSpeaking) * 100) : 0;

const topSpeaker = [...sitting.aggregates.speaking_time_by_speaker].sort((a, b) => b.seconds - a.seconds)[0];
const substantivePct = totalSpeaking > 0
  ? Math.round(((sitting.aggregates.content_class_split.substantive ?? 0) / totalSpeaking) * 100)
  : 0;
const attackPct = totalSpeaking > 0
  ? Math.round(((sitting.aggregates.content_class_split.attack ?? 0) / totalSpeaking) * 100)
  : 0;

// Distinct topics touched (deduplicated across segments).
const allTopics = new Set<string>();
for (const seg of sitting.segments) for (const t of seg.topics) allTopics.add(t);
---
<Base title={`${dateFmt} — TN Assembly Watch`}>
  <div class="space-y-6">
    <!-- Header -->
    <header class="flex flex-wrap items-end gap-x-6 gap-y-2">
      <div>
        <div class="text-xs uppercase tracking-wider text-slate-500">
          {sitting.assembly}th Assembly · Session {sitting.session} · Sitting {sitting.sitting_number}
        </div>
        <h1 class="text-2xl font-semibold">{dateFmt}</h1>
      </div>
      <div class="flex items-center gap-4 text-sm text-slate-600 dark:text-slate-400">
        <div><span class="font-medium text-slate-900 dark:text-slate-100">{totalHours}h {totalMins}m</span> sat</div>
        <div><span class="font-medium text-slate-900 dark:text-slate-100">{sitting.official.bills.length}</span> bill{sitting.official.bills.length === 1 ? '' : 's'}</div>
        <div><span class="font-medium text-slate-900 dark:text-slate-100">{sitting.official.questions_count.starred}</span> starred Qs</div>
        <div><span class="font-medium text-slate-900 dark:text-slate-100">{walkouts.length}</span> walkout{walkouts.length === 1 ? '' : 's'}</div>
        <div><span class="font-medium text-slate-900 dark:text-slate-100">{adjournments.length}</span> adjournment{adjournments.length === 1 ? '' : 's'}</div>
      </div>
    </header>

    <!-- Source attribution banner -->
    {sitting.source_mode === 'curated_public_reporting' && (
      <div class="rounded-lg border border-amber-300 dark:border-amber-800 bg-amber-50 dark:bg-amber-950/30 px-4 py-3 text-sm">
        <div class="flex items-start gap-2">
          <span class="font-semibold text-amber-800 dark:text-amber-300">Curated from public reporting.</span>
          <span class="text-amber-900 dark:text-amber-200/90">{sitting.source_notes}</span>
        </div>
      </div>
    )}

    <!-- Key Insights -->
    <section class="rounded-lg border border-slate-200 dark:border-slate-800 p-4">
      <h2 class="text-lg font-semibold mb-3">Key insights</h2>
      <ul class="space-y-2 text-sm text-slate-700 dark:text-slate-300">
        <li><span class="text-slate-500">·</span> The ruling side held the floor for <strong>{rulingPct}%</strong> of the day's speaking time, with <strong>{topSpeaker?.name}</strong> as the single longest speaker at <strong>{Math.round((topSpeaker?.seconds ?? 0) / 60)} minutes</strong>.</li>
        <li><span class="text-slate-500">·</span> <strong>{substantivePct}%</strong> of speaking time was classified as substantive policy discussion; <strong>{attackPct}%</strong> was direct personal or partisan attack.</li>
        {walkouts.length > 0 && (
          <li><span class="text-slate-500">·</span> {walkouts.length} walkout{walkouts.length === 1 ? '' : 's'} recorded during the sitting — see the timeline for the exact moment.</li>
        )}
        {allTopics.size > 0 && (
          <li><span class="text-slate-500">·</span> Topics touched: {[...allTopics].slice(0, 8).map(t => <span class="inline-block text-[11px] px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 mr-1">#{t}</span>)}{allTopics.size > 8 && <span class="text-slate-500 text-xs">and {allTopics.size - 8} more</span>}</li>
        )}
      </ul>
    </section>

    <!-- Timeline ribbon -->
    <section class="rounded-lg border border-slate-200 dark:border-slate-800 p-4">
      <TimelineRibbon
        client:load
        segments={sitting.segments}
        totalSeconds={sitting.video.duration_seconds}
      />
    </section>

    <!-- Video + Transcript, side by side on large screens -->
    <section class="grid grid-cols-1 lg:grid-cols-5 gap-6">
      <div class="lg:col-span-3 space-y-3">
        <VideoPlayer
          client:load
          youtubeId={sitting.video.youtube_id}
          startOffsetSeconds={sitting.video.start_offset_seconds}
        />
        {sitting.video.video_source_note && (
          <div class="text-xs text-amber-700 dark:text-amber-400">
            ⓘ {sitting.video.video_source_note}
          </div>
        )}
        <div class="text-xs text-slate-500">
          Business list of the day:
          <ul class="mt-1 list-disc pl-5 space-y-0.5">
            {sitting.official.list_of_business.map(item => <li>{item}</li>)}
          </ul>
        </div>
      </div>
      <div class="lg:col-span-2">
        <TranscriptViewer client:load segments={sitting.segments} />
      </div>
    </section>

    <!-- Speaking time -->
    <section>
      <h2 class="text-lg font-semibold mb-3">How the floor was used</h2>
      <SpeakingTimeDonut client:load sitting={sitting} mlas={mlas} />
    </section>

    <!-- Notable events -->
    {sitting.events.length > 0 && (
      <section class="rounded-lg border border-slate-200 dark:border-slate-800 p-4">
        <h2 class="text-lg font-semibold mb-3">Notable moments</h2>
        <ul class="text-sm space-y-2">
          {sitting.events.map(ev => (
            <li class="flex items-start gap-3">
              <span class="text-xs tabular-nums text-slate-500 mt-0.5 w-16 shrink-0">
                {Math.floor(ev.at_seconds / 3600)}h {Math.floor((ev.at_seconds % 3600) / 60)}m
              </span>
              <span class="inline-block px-2 py-0.5 text-xs rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 capitalize shrink-0">
                {ev.type.replace('_', ' ')}
              </span>
              <span class="text-slate-700 dark:text-slate-300">{ev.detail}</span>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Base>
