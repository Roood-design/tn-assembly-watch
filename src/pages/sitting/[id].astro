---
import Base from '../../layouts/Base.astro';
import TimelineRibbon from '../../components/TimelineRibbon';
import SpeakingTimeDonut from '../../components/SpeakingTimeDonut';
import VideoPlayer from '../../components/VideoPlayer';
import TranscriptViewer from '../../components/TranscriptViewer';
import type { Sitting, Mla } from '../../types';

// Statically pre-render one page per JSON file in data/sittings.
export async function getStaticPaths() {
  const sittingModules = import.meta.glob('../../../data/sittings/*.json', { eager: true });
  const mlas = (await import('../../../data/mlas.json')).default as Mla[];
  return Object.values(sittingModules).map((mod: any) => {
    const sitting = (mod.default ?? mod) as Sitting;
    return { params: { id: sitting.sitting_id }, props: { sitting, mlas } };
  });
}

const { sitting, mlas } = Astro.props as { sitting: Sitting; mlas: Mla[] };

const dateFmt = new Intl.DateTimeFormat('en-IN', {
  weekday: 'long', year: 'numeric', month: 'long', day: 'numeric',
}).format(new Date(sitting.date));

const totalHours = Math.floor(sitting.aggregates.total_active_seconds / 3600);
const totalMins = Math.round((sitting.aggregates.total_active_seconds % 3600) / 60);
---
<Base title={`${dateFmt} — TN Assembly Watch`}>
  <div class="space-y-6">
    <!-- Header -->
    <header class="flex flex-wrap items-end gap-x-6 gap-y-2">
      <div>
        <div class="text-xs uppercase tracking-wider text-slate-500">
          {sitting.assembly}th Assembly · Session {sitting.session} · Sitting {sitting.sitting_number}
        </div>
        <h1 class="text-2xl font-semibold">{dateFmt}</h1>
      </div>
      <div class="flex items-center gap-4 text-sm text-slate-600 dark:text-slate-400">
        <div><span class="font-medium text-slate-900 dark:text-slate-100">{totalHours}h {totalMins}m</span> sat</div>
        <div><span class="font-medium text-slate-900 dark:text-slate-100">{sitting.official.bills.length}</span> bill{sitting.official.bills.length === 1 ? '' : 's'}</div>
        <div><span class="font-medium text-slate-900 dark:text-slate-100">{sitting.official.questions_count.starred}</span> starred Qs</div>
        <div><span class="font-medium text-slate-900 dark:text-slate-100">{sitting.events.filter(e => e.type === 'adjournment').length}</span> adjournment{sitting.events.filter(e => e.type === 'adjournment').length === 1 ? '' : 's'}</div>
      </div>
    </header>

    <!-- Timeline ribbon -->
    <section class="rounded-lg border border-slate-200 dark:border-slate-800 p-4">
      <TimelineRibbon
        client:load
        segments={sitting.segments}
        totalSeconds={sitting.video.duration_seconds}
      />
    </section>

    <!-- Video + Transcript, side by side on large screens -->
    <section class="grid grid-cols-1 lg:grid-cols-5 gap-6">
      <div class="lg:col-span-3 space-y-3">
        <VideoPlayer
          client:load
          youtubeId={sitting.video.youtube_id}
          startOffsetSeconds={sitting.video.start_offset_seconds}
        />
        <div class="text-xs text-slate-500">
          Business list of the day:
          <ul class="mt-1 list-disc pl-5 space-y-0.5">
            {sitting.official.list_of_business.map(item => <li>{item}</li>)}
          </ul>
        </div>
      </div>
      <div class="lg:col-span-2">
        <TranscriptViewer client:load segments={sitting.segments} />
      </div>
    </section>

    <!-- Speaking time -->
    <section>
      <h2 class="text-lg font-semibold mb-3">How the floor was used</h2>
      <SpeakingTimeDonut client:load sitting={sitting} mlas={mlas} />
    </section>

    <!-- Notable events -->
    {sitting.events.length > 0 && (
      <section class="rounded-lg border border-slate-200 dark:border-slate-800 p-4">
        <h2 class="text-lg font-semibold mb-3">Notable moments</h2>
        <ul class="text-sm space-y-2">
          {sitting.events.map(ev => (
            <li class="flex items-start gap-3">
              <span class="text-xs tabular-nums text-slate-500 mt-0.5">
                {Math.floor(ev.at_seconds / 3600)}h {Math.floor((ev.at_seconds % 3600) / 60)}m
              </span>
              <span class="inline-block px-2 py-0.5 text-xs rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 capitalize">
                {ev.type.replace('_', ' ')}
              </span>
              <span class="text-slate-700 dark:text-slate-300">{ev.detail}</span>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Base>
