---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
export interface Props {
  title: string;
  current: 'calendar' | 'sittings' | 'mlas' | 'bills' | 'methodology';
}
const { title, current } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="app-shell">
      <Sidebar current={current} />
      <main class="app-main">
        <slot />
        <footer class="app-footer">
          Public data · every claim links back to the assembly recording ·
          <a href="https://github.com/Roood-design/tn-assembly-watch">source</a>
        </footer>
      </main>
    </div>
  </body>
</html>

<style is:global>
  html, body { margin: 0; padding: 0; }
  body {
    font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    color: rgb(15 23 42);
    background: white;
    -webkit-font-smoothing: antialiased;
  }
  :root[data-theme="dark"] body,
  :root:not([data-theme="light"]) body {
    background: rgb(2 6 15);
    color: rgb(226 232 240);
  }
  code, pre, .mono {
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .app-shell {
    display: flex;
    align-items: stretch;
    min-height: 100vh;
  }
  .app-main {
    flex: 1;
    min-width: 0;
    padding: 32px 40px 24px;
    max-width: 1400px;
  }
  .app-footer {
    margin-top: 40px;
    padding-top: 20px;
    font-size: 12px;
    color: rgb(100 116 139);
    border-top: 1px solid rgb(226 232 240);
  }
  :root[data-theme="dark"] .app-footer,
  :root:not([data-theme="light"]) .app-footer {
    border-top-color: rgb(30 41 59);
    color: rgb(100 116 139);
  }
  .app-footer a { color: inherit; }

  @media (max-width: 900px) {
    .app-shell { flex-direction: column; }
    .app-main { padding: 20px 16px; }
  }
</style>
