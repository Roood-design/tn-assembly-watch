# Copy to pipeline/.env and fill in your API keys.
# .env is gitignored — never commit real keys.

# Groq — used for Whisper ASR (whisper-large-v3-turbo).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Anthropic — used for segment classification (Claude Haiku 4.5).
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
